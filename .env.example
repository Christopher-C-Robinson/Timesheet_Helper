# Copy this file to .env and fill in values for your machine.
# .env is intentionally ignored by Git.

# task_duration.py
TASK_DURATION_ROOT=C:\Users\you\OneDrive - Example Org\Timesheet Notes
TASK_DURATION_WORK_ITEM=12345
TASK_DURATION_EXTENSIONS=.docx
TASK_DURATION_CLOUD_MODE=word-refresh
TASK_DURATION_INCLUDE_UNSAVED_WORD=false
TASK_DURATION_VERBOSE=false

# azureDevopsAPI.py
AZURE_DEVOPS_ORGANIZATION=example-organization
AZURE_DEVOPS_TEST_CASE_ID=12345
AZURE_DEVOPS_API_VERSION=7.1
AZURE_DEVOPS_PAT=
